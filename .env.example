# Runtime
NODE_ENV=development
PERSISTIO_MODE=combined
PORT=4827
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://persistio:persistio@postgres:5432/persistio
DB_POOL_MAX=20

# Auth
ADMIN_API_KEY=change-me-in-production
# Shared by the platform API and App Worker platform health proxy.
HEALTH_API_KEY=

# Persistio App Worker (Cloudflare Worker / local wrangler)
# DB and VAULT_KEYS are Worker bindings configured in app/worker/wrangler.toml,
# not string env vars. ADMIN_API_KEY and HEALTH_API_KEY above are also consumed
# by the App Worker when it calls the platform API.
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
AUTH0_CLIENT_ID=
ROOT_ADMIN_AUTH0_SUB=
PLATFORM_API_URL=http://127.0.0.1:4827
STRIPE_WEBHOOK_SECRET=

# Persistio App Web (Vite / Cloudflare Pages)
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=
VITE_API_BASE_URL=http://127.0.0.1:8787/api

# Embedder
EMBEDDER_PROVIDER=ollama
# Do not set OPENAI_BASE_URL for embeddings; the OpenAI SDK reads it implicitly.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
STORAGE_EMBEDDING_DIMENSIONS=1024

# Ollama/Qwen embeddings. Keep this endpoint private to the deployment network.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b

# TEI/Qwen embeddings. Set EMBEDDER_PROVIDER=tei to use these instead of Ollama.
TEI_BASE_URL=http://tei:80
TEI_EMBEDDING_MODEL=text-embeddings-inference

# Vertex embeddings. Set EMBEDDER_PROVIDER=vertex for managed GCP embeddings.
VERTEX_PROJECT_ID=
VERTEX_LOCATION=europe-west2
VERTEX_EMBEDDING_MODEL=gemini-embedding-001
VERTEX_EMBEDDING_DIMENSIONS=0

# Legacy extractor fallback. Role-specific settings below fall back to these
# when omitted, so keep these aligned with routine extraction.
EXTRACTOR_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
EXTRACTOR_API_KEY=
EXTRACTOR_MODEL=gemini-2.5-flash
EXTRACTOR_PROMPT_FILE=prompts/extractor.txt

# LLM role overrides (OpenAI-compatible)
# Use these to route routine extraction to a cheaper model while keeping
# escalation/arbitration on a stronger model.
# When switching provider for a role, set BASE_URL, API_KEY, and MODEL together.
EXTRACTION_BASE_URL=
EXTRACTION_API_KEY=
EXTRACTION_MODEL=
ESCALATION_BASE_URL=
ESCALATION_API_KEY=
ESCALATION_MODEL=

# Curator
CURATOR_AUTO_RUN=false
CURATOR_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
CURATOR_API_KEY=
CURATOR_MODEL=gemini-2.5-flash
CURATOR_PROMPT_FILE=prompts/curator.txt

# Prompt loading
# The compose quick start keeps this legacy in-image path so the sample env works
# with both the currently pinned compose image and newer images. Newer images also
# expose the same basic public prompts at /prompts for direct container runs.
PROMPTS_DIR=/app/packages/server/prompts

# Raw chunk storage
# Use local for self-host/dev, azure_blob for Azure Container Apps, or gcs for Cloud Run.
# Relative local paths are resolved from packages/server so operator scripts
# and the runtime use the same directory.
RAW_CHUNK_STORAGE_PROVIDER=local
RAW_CHUNK_LOCAL_DIR=./data/raw-chunks
RAW_CHUNK_BLOB_CONTAINER=raw-chunks
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_CONNECTION_STRING=
RAW_CHUNK_GCS_BUCKET=

# Worker scheduling and throughput
EXTRACTION_INTERVAL_MS=30000
EXTRACTION_BATCH_SIZE=20
MAX_EXTRACTION_RETRIES=5
CURATION_INTERVAL_MS=2000
CURATION_BATCH_SIZE=5
MAX_CURATION_RETRIES=5
# Use webhook, azure_service_bus, or gcp_pubsub to dispatch platform_event_outbox rows.
# noop keeps outbox rows pending instead of marking undelivered events delivered.
EVENT_PUBLISHER=noop
PLATFORM_EVENTS_WEBHOOK_URL=
PLATFORM_EVENTS_WEBHOOK_SECRET=
PLATFORM_EVENTS_WEBHOOK_TIMEOUT_MS=30000
AZURE_SERVICE_BUS_CONNECTION_STRING=
AZURE_SERVICE_BUS_FULLY_QUALIFIED_NAMESPACE=
AZURE_SERVICE_BUS_TOPIC_OR_QUEUE=
GCP_PUBSUB_PROJECT_ID=
GCP_PUBSUB_TOPIC=
EVENT_OUTBOX_DISPATCH_INTERVAL_MS=10000
EVENT_OUTBOX_BATCH_SIZE=20
EVENT_OUTBOX_MAX_ATTEMPTS=5
EVENT_OUTBOX_RETRY_BASE_DELAY_MS=1000
EVENT_OUTBOX_RETRY_MAX_DELAY_MS=300000
EXTRACTION_WORKER_CONCURRENCY=5
ARBITRATION_BATCH_SIZE=15

# Extraction and recall behavior
MAX_INGEST_CHUNKS=100
INGEST_EMBEDDING_CONCURRENCY=4
INGEST_RATE_LIMIT_RPM=60
INGEST_CHUNK_MAX_CHARS=8000
BULK_INGEST_MAX_CHUNKS=2048
BULK_INGEST_BODY_LIMIT_BYTES=26214400
EXTRACTION_SCORE_THRESHOLD=5
SEGMENTATION_THRESHOLD=0.75
DEFAULT_TOKEN_BUDGET=2000
DEFAULT_RECALL_TOP_K=10
SUBJECT_INJECTION_TOP_N=10
SUBJECT_INJECTION_RECENT_N=10
SUBJECT_TEXT_MATCH_DISTANCE=2
SUBJECT_EMBED_HIGH_THRESHOLD=0.92
SUBJECT_EMBED_LOW_THRESHOLD=0.80

# Circuit breaker and maintenance
CIRCUIT_BREAKER_THRESHOLD=3
CIRCUIT_BREAKER_PROBE_INTERVAL_MS=300000
CIRCUIT_BREAKER_MAX_PROBE_INTERVAL_MS=600000
MEMORY_ARCHIVE_TTL_DAYS=90
CONTRADICTION_SCAN_ENABLED=false
CONTRADICTION_MAX_ARBITRATIONS_PER_BATCH=20
CONTRADICTION_SCAN_MIN_SIMILARITY=0.70
CONFIDENCE_DECAY_INTERVAL_DAYS=30
CONFIDENCE_DECAY_AUTO_ARCHIVE_SALIENCE_THRESHOLD=0.3

# Observability
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Encryption
ENCRYPTION_ENABLED=false
KEY_PROVIDER=azure_key_vault
KEY_VAULT_URI=
KEK_KEY_NAME=
GCP_KMS_KEY_NAME=
