{
  "name": "@persistio/server",
  "version": "0.1.19",
  "private": true,
  "license": "BUSL-1.1",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json && rm -rf dist/db/migrations && mkdir -p dist/db/migrations && cp src/db/migrations/*.sql dist/db/migrations/ && cp -R src/db/migrations/down dist/db/migrations/down",
    "start": "node --require ./dist/preload.js dist/index.js",
    "test": "vitest run",
    "migrate:raw-chunks": "node ./scripts/migrate-raw-chunks-to-blob.mjs",
    "migrate:qwen3-embeddings": "node ./scripts/reembed-qwen3.mjs"
  },
  "dependencies": {
    "@auth0/auth0-fastify-api": "^1.3.0",
    "@azure/identity": "^4.11.0",
    "@azure/keyvault-keys": "^4.10.0",
    "@azure/monitor-opentelemetry-exporter": "1.0.0-beta.42",
    "@azure/service-bus": "^7.9.5",
    "@azure/storage-blob": "^12.31.0",
    "@google-cloud/bigquery": "^8.3.1",
    "@google-cloud/firestore": "^8.6.0",
    "@google-cloud/kms": "^5.5.0",
    "@google-cloud/pubsub": "^5.3.0",
    "@google-cloud/storage": "^7.19.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "fastify": "^5.0.0",
    "google-auth-library": "^9.15.1",
    "openai": "^4.0.0",
    "p-limit": "^5.0.0",
    "pg": "^8.0.0",
    "pgvector": "^0.2.0",
    "ws": "^8.21.0",
    "zod": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.8"
  }
}
